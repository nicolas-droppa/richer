<section class="row min-vh-100 align-items-center">
  <div class="col-12">
    <h2 class="text-center">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-2 row g-3"}) do |f| %>
      <div class="field">
        <p><%= f.label :email, class: 'form-label' %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control' %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, class: 'form-label' %></p>
        <p><%= f.password_field :password, autocomplete: "current-password", class: 'form-control' %></p>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field">
          <p><%= f.check_box :remember_me, class: 'form-check-input' %></p>
          <p><%= f.label :remember_me, class: 'form-check-label' %></p>
        </div>
      <% end %>

      <div class="d-grid mt-4">
        <%= f.submit "Log in", class: 'btn btn-primary' %>
      </div>
    <% end %>

    <div class="mt-2 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
