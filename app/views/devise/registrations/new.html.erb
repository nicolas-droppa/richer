<section class="row min-vh-100 align-items-center">
  <div class="col-12">
    <h2 class="text-center"><%= t('.header') %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-2 row"}) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <p><%= f.label :email, class: 'form-label' %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control' %></p>
      </div>

      <div class="field">
        <p><%= f.label :given_name, class: 'form-label' %></p>
        <p><%= f.text_field :given_name, autofocus: true, autocomplete: "given_name", class: 'form-control' %></p>
      </div>

      <div class="field">
        <p><%= f.label :family_name, class: 'form-label' %></p>
        <p><%= f.text_field :family_name, autofocus: true, autocomplete: "family_name", class: 'form-control' %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, class: 'form-label' %></p>
        <% if @minimum_password_length %>
          <p><em>(<%= t('.minimum_password_length', count: @minimum_password_length) %>)</em></p>
        <% end %>
        <p><%= f.password_field :password, autocomplete: "new-password", class: 'form-control' %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, class: 'form-label' %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control' %></p>
      </div>

      <div class="d-grid mt-4">
        <%= f.submit t('.register'), class: 'btn btn-primary' %>
      </div>
    <% end %>

    <div class="mt-2 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
